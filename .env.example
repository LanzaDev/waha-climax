# ============================================================
#  CONFIGURAÇÃO LOCAL — copie este arquivo para ".env" e edite
#
#      copy .env.example .env     (Windows)
#      cp .env.example .env       (Linux/macOS)
#
#  O arquivo .env é ignorado pelo git (ver .gitignore): seus
#  dados ficam só na sua máquina e NÃO vão pro GitHub.
# ============================================================

# ---------- WhatsApp (WAHA) ----------
# Número de destino: 55 + DDD + número (sem espaços nem traços) + @c.us
WHATSAPP_CHAT_ID=SEU_NUMERO_AQUI@c.us
# Nome da sessão criada no WAHA (GET http://localhost:3000/api/sessions)
WAHA_SESSION=SUA_SESSAO_AQUI
# URL do WAHA
WAHA_URL=http://localhost:3000

# ---------- Localização do mapa (Windy) ----------
# Coordenadas do centro do mapa e rótulo usado nos relatórios
CLIMA_LAT=-22.264
CLIMA_LON=-49.136
CLIMA_LOCAL=Bauru/SP e região

# ---------- API local (api.py) ----------
# 0.0.0.0 = aceita conexões de fora (necessário para o n8n em Docker
# chegar pela máquina host via host.docker.internal). Use 127.0.0.1
# se quiser restringir só a esta máquina.
CLIMA_HOST=0.0.0.0
CLIMA_PORT=8000
# Quanto tempo esperar o Windy carregar, em milissegundos
CLIMA_WAIT_MS=15000
# 0 = abre a janela do navegador (depuração); 1 = modo silencioso
CLIMA_HEADLESS=1
